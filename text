<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Expense Tracker</title>
    <style>
 
        body
        {
            background-color: rgb(30, 60, 90);
            font-family: arial;
            margin: 0;
            padding: 0;
        }
 
        h1 
        {
            margin-top: 25px;
            font-size: 30px;
            color: white;
            text-align: center;
        }        
 
        form
        {
            font-family: arial;
            background-color: rgb(109, 180, 221);
            margin: 15vh auto 20px auto;
            padding:30px;
            max-width:400px;
            border-radius:25px;
            min-height: 420px;
          
        }
       
        .fields 
        {
            display: flex;
            flex-direction: column;
            gap:5px;            
            margin-bottom: 15px; 
        }
 
        input, select 
        {
            padding:8px 8px;
            border: none;
            border-radius: 4px;
            font-size: 16px;
        }
 
        button 
        {
            padding:10px 10px 10px;
            background-color: rgb(51, 97, 138);
            color: white;
            border: none;
            border-radius: 20px;
            cursor: pointer;
            font-size: 16px;
            align-self: center;
        }
 
    
        label
        {
            color:white;
            font-weight: bold;
            font-size: 18px;
        }
 
        p
        {
            color:red;
            margin-bottom: 0;
        }
 
        /* ── Expense List Section ── */
        #expense-section
        {
            max-width: 700px;
            margin: 0 auto 40px auto;
            background-color: rgb(109, 180, 221);
            border-radius: 25px;
            padding: 25px 30px;
        }
 
        #expense-section h2
        {
            color: white;
            text-align: center;
            margin-top: 0;
            font-size: 24px;
        }
 
        table
        {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 15px;
        }
 
        thead tr
        {
            background-color: rgb(51, 97, 138);
            color: white;
        }
 
        th, td
        {
            padding: 10px 14px;
            text-align: left;
            font-size: 15px;
        }
 
        tbody tr
        {
            background-color: rgba(255, 255, 255, 0.85);
        }
 
        tbody tr:nth-child(even)
        {
            background-color: rgba(255, 255, 255, 0.6);
        }
 
        .delete-btn
        {
            background-color: rgb(190, 50, 50);
            color: white;
            border: none;
            border-radius: 8px;
            padding: 5px 10px;
            cursor: pointer;
            font-size: 13px;
        }
 
        .total-row
        {
            background-color: rgb(51, 97, 138) !important;
            color: white;
            font-weight: bold;
        }
 
        #no-expense-msg
        {
            color: white;
            text-align: center;
            font-size: 16px;
        }
 
        .category-badge
        {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 12px;
            font-size: 13px;
            font-weight: bold;
            text-transform: uppercase;
            color: white;
        }
 
        .food          { background-color: #e67e22; }
        .travel        { background-color: #2980b9; }
        .shopping      { background-color: #8e44ad; }
        .bills         { background-color: #c0392b; }
        .entertainment { background-color: #27ae60; }
        .health        { background-color: #16a085; }
 
    </style>
</head>
<body>
 
    <form>
        <h1>Expense Tracker</h1>
        <div class="fields">
            <label for="title">Expense Title : </label>
            <input type="text" id="title" placeholder="Enter an expense title">
        </div>
        <div class="fields">
            <label for="amount">Expense Amount : </label>
            <input type="number" step="any" id="amount" placeholder="Enter an expense amount">
        </div>
        <div class="fields">  
            <label for="category">Choose an expense category : </label>
            <select id="category" name="expensecategory">
                <option value="food">Food</option>
                <option value="travel">Travel</option>
                <option value="shopping">Shopping</option>
                <option value="bills">Bills</option>
                <option value="entertainment">Entertainment</option>
                <option value="health">Health</option>
            </select>
        </div>
        <div class="fields">
            <button type="button" onclick="addexpense()">Add Expense</button>
            <p id="error"></p>
        </div>
    </form>
 
    <!-- Expense List Section (hidden until first expense is added) -->
    <div id="expense-section" style="display:none;">
        <h2>My Expenses</h2>
        <p id="no-expense-msg" style="display:none;">No expenses added yet.</p>
        <table id="expense-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Amount (₹)</th>
                    <th>Remove</th>
                </tr>
            </thead>
            <tbody id="expense-body">
                <!-- Expense rows go here -->
            </tbody>
            <tfoot>
                <tr class="total-row">
                    <td colspan="3" style="text-align:right;">Total :</td>
                    <td id="total-amount">₹0.00</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
 
    <script>
 
        // Array to store all expense objects
        let expenses = [];
 
        // Counter to give each expense a unique id
        let expenseCounter = 0;
 
        function addexpense()
        {
            let title  = document.getElementById("title").value.trim();
            let amount = Number(document.getElementById("amount").value.trim());
            let category = document.getElementById("category").value;
 
            // Validation (your original logic kept exactly)
            if (!title || !amount || amount < 0)
            {
                document.getElementById("error").textContent = "all fields are required";
                return;
            }
 
            document.getElementById("error").textContent = "";
 
            // Create an expense object using Object concept
            let newExpense = {
                id       : expenseCounter,
                title    : title,
                amount   : amount,
                category : category
            };
 
            expenseCounter = expenseCounter + 1;
 
            // Push the new expense into the array
            expenses.push(newExpense);
 
            // Clear inputs (your original line kept)
            document.getElementById("title").value  = "";
            document.getElementById("amount").value = "";
 
            // Re-render the table
            renderTable();
        }
 
        function deleteExpense(id)
        {
            // Loop through expenses array and find the index with matching id
            let indexToDelete = -1;
 
            for (let i = 0; i < expenses.length; i++)
            {
                if (expenses[i].id === id)
                {
                    indexToDelete = i;
                    break;
                }
            }
 
            // Remove that one item using splice
            if (indexToDelete !== -1)
            {
                expenses.splice(indexToDelete, 1);
            }
 
            renderTable();
        }
 
        function calcTotal()
        {
            let total = 0;
 
            for (let i = 0; i < expenses.length; i++)
            {
                total = total + expenses[i].amount;
            }
 
            return total;
        }
 
        function getCategoryLabel(category)
        {
            // Use a switch to return a readable label
            switch (category)
            {
                case "food"          : return "Food";
                case "travel"        : return "Travel";
                case "shopping"      : return "Shopping";
                case "bills"         : return "Bills";
                case "entertainment" : return "Entertainment";
                case "health"        : return "Health";
                default              : return category;
            }
        }
 
        function renderTable()
        {
            const tbody   = document.getElementById("expense-body");
            const section = document.getElementById("expense-section");
            const noMsg   = document.getElementById("no-expense-msg");
            const totalEl = document.getElementById("total-amount");
 
            // Clear existing rows
            tbody.innerHTML = "";
 
            // Show or hide the whole section
            if (expenses.length === 0)
            {
                section.style.display = "none";
                return;
            }
 
            section.style.display = "block";
            noMsg.style.display   = "none";
 
            // Build a row for each expense using template literals
            for (let i = 0; i < expenses.length; i++)
            {
                let exp = expenses[i];
 
                let row = document.createElement("tr");
 
                row.innerHTML = `
                    <td>${i + 1}</td>
                    <td>${exp.title}</td>
                    <td>
                        <span class="category-badge ${exp.category}">
                            ${getCategoryLabel(exp.category)}
                        </span>
                    </td>
                    <td>₹${exp.amount.toFixed(2)}</td>
                    <td>
                        <button class="delete-btn" onclick="deleteExpense(${exp.id})">Delete</button>
                    </td>
                `;
 
                tbody.appendChild(row);
            }
 
            // Update total
            let total = calcTotal();
            totalEl.textContent = `₹${total.toFixed(2)}`;
        }
      
    </script>
 
</body>
</html>